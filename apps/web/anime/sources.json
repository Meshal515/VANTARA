    {
      "id": "okanime",
      "name": "OkAnime",
      "priority": 70,
      "extension": {
        "pkg": "eu.kanade.tachiyomi.animeextension.ar.okanime",
        "apk": "https://raw.githubusercontent.com/yuzono/anime-repo/repo/apk/aniyomi-ar.okanime-v14.26.apk",
        "sha256": "ff5c3fc383f2063a62ee954158669186a59fac66aefbebbe2c8b2cd11b774ed3",
        "version": "14.26"
      },
      "domains": {
        "current": "https://ww3.okanime.xyz",
        "legacy": [
          "https://www.okanime.xyz",
          "https://okanime.xyz"
        ],
        "fingerprint": "OkAnime|اوك انمي",
        "rewrites": [
          { "path": "/search/", "to": "/search", "params": { "s": "q" } }
        ]
      },
      "episodes": {
        "selector": "a.ep-compact-btn[href*=/episode/]",
        "numberPattern": "-episode-([0-9]+(?:\\.[0-9]+)?)/?$"
      },
      "embeds": {
        "selector": "a.ep-link[data-server]",
        "attr": "@click",
        "pattern": "setServer\\('([^']+)'\\)",
        "nameAttr": "data-server",
        "qualityAttr": "data-umami-event-quality"
      },
      "catalog": {
        "urlTemplate": "/anime-list?page={page}",
        "cards": {
          "card": "div.anime-card",
          "link": "div.anime-title h4 a",
          "image": "img"
        },
        "ratePerSecond": 1.0,
        "maxPages": 1000
      }
    },
    {
