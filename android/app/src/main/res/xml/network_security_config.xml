<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS إلزامي، باستثناء مضيفات محلية معيّنة بالاسم.

  خادم المحتوى يُوصل عبر Cloudflare Tunnel وهو https، فالقاعدة العامة تمنع
  الاتصال غير المشفّر: لا شيء يخرج إلى الإنترنت بلا تشفير، ومزامنة Cloudflare
  لا تتأثر.

  الاستثناء للتجربة على الشبكة المنزلية. ومهم: أندرويد يطابق المضيف بالاسم
  تمامًا ولا يفهم نطاقات IP — فـ`192.168.0.0` لا تعني الشبكة كلها، تعني ذلك
  العنوان وحده. لاستخدام عنوان محلي بـhttp أضفه هنا صراحةً:

      <domain includeSubdomains="false">192.168.1.40</domain>

  والأنظف من ذلك: وجّه اسمًا محليًا (vantara.local) إلى الجهاز.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- مضيف المحاكي كما يراه الجهاز الافتراضي -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="true">vantara.local</domain>
    </domain-config>

    <!--
      مضيفات مصادر القراءة، مسمّاةً واحدًا واحدًا.

      لماذا استثناء أصلًا: شبكات توصيل صور الفصول لا تزال بعضها على http،
      ومنعُه يُنتج **فشلًا كاذبًا** — صورة سليمة تُردّ فيُقرأ المنع كعطل
      محرك، والتشخيص يذهب في اتجاه خاطئ.

      ولماذا بالاسم لا بقاعدة عامة: حساب المالك ومزامنة D1 تمرّان على نفس
      العميل. `cleartextTrafficPermitted="true"` في `base-config` كان
      سيفتحهما معًا، وثمن صورةٍ لا يُدفع من حساب.

      والمكشوف هنا محتوى صور فقط: لا اعتماد ولا هوية تمرّ على هذه المضيفات.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Mangalek — ورأينا صوره تُخدم من ssolo.mangalik.net -->
        <domain includeSubdomains="true">mangalik.net</domain>
        <domain includeSubdomains="true">mangalek.com</domain>
        <!-- Azora — وصوره من storage.azorafly.com -->
        <domain includeSubdomains="true">azorafly.com</domain>
        <domain includeSubdomains="true">azora.top</domain>
        <!-- MangaSwat — المضيف meshmanga.com والصور من appswat.com -->
        <domain includeSubdomains="true">meshmanga.com</domain>
        <domain includeSubdomains="true">appswat.com</domain>
        <domain includeSubdomains="true">mangaswat.com</domain>
        <!-- Team X -->
        <domain includeSubdomains="true">olympustaff.com</domain>
        <domain includeSubdomains="true">teamx.info</domain>
        <domain includeSubdomains="true">teamxnovel.com</domain>
        <!-- MangaSpark -->
        <domain includeSubdomains="true">mangaspark.com</domain>
        <!-- Hijala — صور الفصول على http من hijala.com نفسه -->
        <domain includeSubdomains="true">hijala.com</domain>
    </domain-config>
    <!--
      ملفات Akwam على downet.net: بعض خوادمها (s205d1، s202d1) ترسل شهادة SSL2BUY بلا
      الوسيط، فيرفض OkHttp/ExoPlayer المصافحة (المتصفحات تجلبه وحدها). نثق بذلك الوسيط
      وحده لهذا النطاق وحده، فوق ثقة النظام (فحص 2026-10-03 من آلة GitHub: verify error 20).
      الوسيط من مُصدره: crt.sectigo.com/SSL2BUYEMEARSADomainValidationSecureServerCA.crt
      sha256 58:F0:F7:56:75:8E:93:FB:0B:6B:17:A3:6A:38:50:47:5D:68:BC:0D:6C:99:CB:E2:2A:1B:18:35:1C:89:FF:1F
    -->
    <domain-config>
        <domain includeSubdomains="true">downet.net</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/ssl2buy_emea_dv" />
        </trust-anchors>
    </domain-config>
</network-security-config>
