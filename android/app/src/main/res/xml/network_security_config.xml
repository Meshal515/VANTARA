<?xml version="1.0" encoding="utf-8"?>
<!--
  HTTPS إلزامي، باستثناء مضيفات محلية معيّنة بالاسم.

  خادم المحتوى يُوصل عبر Cloudflare Tunnel وهو https، فالقاعدة العامة تمنع
  الاتصال غير المشفّر: لا شيء يخرج إلى الإنترنت بلا تشفير، ومزامنة Cloudflare
  لا تتأثر.

  الاستثناء للتجربة على الشبكة المنزلية. ومهم: أندرويد يطابق المضيف بالاسم
  تمامًا ولا يفهم نطاقات IP — فـ`192.168.0.0` لا تعني الشبكة كلها، تعني ذلك
  العنوان وحده. لاستخدام عنوان محلي بـhttp أضفه هنا صراحةً:

      <domain includeSubdomains="false">192.168.1.40</domain>

  والأنظف من ذلك: وجّه اسمًا محليًا (vantara.local) إلى الجهاز.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <!-- مضيف المحاكي كما يراه الجهاز الافتراضي -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="true">vantara.local</domain>
    </domain-config>
</network-security-config>
