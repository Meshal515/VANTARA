+	void torrent::vantara_set_read_hint(int const reader, piece_index_t const piece, int const offset)
+	{
+		if (!valid_metadata() || !has_picker()) return;
+		if (piece < piece_index_t(0) || piece >= m_torrent_file->end_piece()) return;
+		int const n = m_picker->blocks_in_piece(piece);
+		if (n <= 0) return;
+		int const block = std::max(0, std::min(n - 1, std::max(0, offset) / block_size()));
+		time_point const now = aux::time_now();
+		bool const was_empty = m_vantara_hints.empty();
+		auto it = std::find_if(m_vantara_hints.begin(), m_vantara_hints.end()
+			, [reader](vantara_read_hint const& h) { return h.reader == reader; });
+		if (it != m_vantara_hints.end())
+		{
+			if (it->piece == piece && it->block == block) return;
+			piece_index_t const old = it->piece;
+			it->piece = piece;
+			it->block = block;
+			it->frontier = -1;
+			it->frontier_since = now;
+			if (old != piece) vantara_reorder(old);
+		}
+		else m_vantara_hints.push_back({reader, piece, block, -1, now});
+		if (was_empty) g_vantara_hinted_torrents.fetch_add(1, std::memory_order_relaxed);
+		vantara_reorder(piece);
+		if (have_piece(piece) || upload_mode() || is_paused()) return;
+		// start or seek: schedule now, not at the next once-per-second critical pass
+		if (!m_time_critical_pieces.empty()) request_time_critical_pieces();
+		std::set<peer_connection*> with_requests;
+		vantara_frontier(with_requests);
+		for (auto* p : with_requests) p->send_block_requests();
+	}
+
+	void torrent::vantara_clear_read_hint(int const reader)
+	{
+		auto it = std::find_if(m_vantara_hints.begin(), m_vantara_hints.end()
+			, [reader](vantara_read_hint const& h) { return h.reader == reader; });
+		if (it == m_vantara_hints.end()) return;
+		piece_index_t const piece = it->piece;
+		m_vantara_hints.erase(it);
+		vantara_reorder(piece);
+		if (m_vantara_hints.empty()) g_vantara_hinted_torrents.fetch_sub(1, std::memory_order_relaxed);
+	}
+
+	void torrent::vantara_hint_tick()
+	{
+		if (m_vantara_hints.empty() || !has_picker() || upload_mode() || is_paused()) return;
+		std::set<peer_connection*> with_requests;
+		vantara_frontier(with_requests);
+		for (auto* p : with_requests) p->send_block_requests();
+	}
+
+	void torrent::vantara_frontier(std::set<peer_connection*>& with_requests)
+	{
+		int constexpr frontier_blocks = 4;
+		int constexpr max_owners = 3;
+		int budget = 12;
+		if (m_vantara_hints.empty() || !has_picker()) return;
+		std::vector<peer_connection*> candidates;
+		for (auto* c : m_connections)
+			if (c->can_request_time_critical()) candidates.push_back(c);
+		if (candidates.empty()) return;
+		time_point const now = aux::time_now();
+		milliseconds const stall(vantara_frontier_ms());
+		int const block_bytes = block_size();
+		auto const queue = m_picker->get_download_queue();
+		int const count = int(m_vantara_hints.size());
+		for (int k = 0; k < count && budget > 0; ++k)
+		{
+			// round-robin: the head, the tail, a warm-up and a seek all advance
+			auto& h = m_vantara_hints[std::size_t((m_vantara_rr + k) % count)];
+			if (m_picker->have_piece(h.piece)) continue;
+			int const n = m_picker->blocks_in_piece(h.piece);
+			auto const dp = std::find_if(queue.begin(), queue.end()
+				, [&h](piece_picker::downloading_piece const& d) { return d.index == h.piece; });
+			span<piece_picker::block_info const> blocks;
+			if (dp != queue.end()) blocks = m_picker->blocks_for_piece(*dp);
+			auto const state_of = [&](int const b) {
+				return blocks.empty() ? piece_picker::block_info::state_none : int(blocks[b].state);
+			};
+			int first = -1;
+			for (int b = h.block; b < n; ++b)
+			{
+				int const st = state_of(b);
+				if (st != piece_picker::block_info::state_finished
+					&& st != piece_picker::block_info::state_writing) { first = b; break; }
+			}
+			// everything from the reader to the end of the piece is on disk already
+			if (first < 0) continue;
+			if (first != h.frontier) { h.frontier = first; h.frontier_since = now; }
+			bool const stalled = now - h.frontier_since >= stall;
+			int seen = 0;
+			for (int b = first; b < n && seen < frontier_blocks && budget > 0; ++b)
+			{
+				int const st = state_of(b);
+				if (st == piece_picker::block_info::state_finished
+					|| st == piece_picker::block_info::state_writing) continue;
+				++seen;
+				piece_block const block(h.piece, b);
+				bool const requested = st == piece_picker::block_info::state_requested;
+				int const owners = blocks.empty() ? 0 : int(blocks[b].num_peers);
+				// a requested block is duplicated only once the frontier stands still
+				if (requested && (!stalled || owners >= max_owners)) continue;
+				peer_connection* best = nullptr;
+				std::int64_t best_score = std::numeric_limits<std::int64_t>::max();
+				for (auto* c : candidates)
+				{
+					if (!c->has_piece(h.piece)) continue;
+					auto const& dq = c->download_queue();
+					auto const& rq = c->request_queue();
+					if (std::find_if(dq.begin(), dq.end(), aux::has_block(block)) != dq.end()) continue;
+					if (std::find_if(rq.begin(), rq.end(), aux::has_block(block)) != rq.end()) continue;
+					std::int64_t const queued = std::int64_t(dq.size() + rq.size());
+					int const rate = c->statistics().download_payload_rate();
+					// idle first, then known-fast, then the shortest queue of unknown speed
+					std::int64_t const score = queued == 0 ? 0
+						: rate > 0 ? (queued + 1) * block_bytes * 1000 / rate
+						: std::int64_t(1000000) + queued;
+					if (score < best_score) { best = c; best_score = score; }
+				}
+				if (best == nullptr) continue;
+				request_flags_t const flags = peer_connection::time_critical
+					| (requested ? peer_connection::busy : request_flags_t{});
+				if (best->add_request(block, flags))
+				{
+					with_requests.insert(best);
+					--budget;
+				}
+			}
+		}
+		if (count > 0) m_vantara_rr = (m_vantara_rr + 1) % count;
+	}
