+#ifndef TORRENT_DISABLE_STREAMING
+	// VANTARA (read-hints): libtorrent offers a piece's blocks from block 0 upward
+	// (piece_picker::add_blocks, add_blocks_downloading). A player fed written
+	// blocks before the piece is verified needs the blocks at its read position:
+	// a season-pack episode starts inside a piece shared with the previous file,
+	// and an MKV index sits at the end of the last piece. Each open reader has a
+	// hint (piece, block): the picker offers that piece's blocks nearest-ahead to
+	// any reader first, and the frontier (the first unfinished blocks from the
+	// reader) is rescued from slow peers every session tick, fairly across readers.
+	void torrent::vantara_reorder(piece_index_t const piece)
+	{
+		if (!has_picker()) return;
+		int const n = m_picker->blocks_in_piece(piece);
+		std::vector<int> starts;
+		for (auto const& h : m_vantara_hints)
+			if (h.piece == piece) starts.push_back(h.block);
+		if (starts.empty() || n <= 0)
+		{
+			m_picker->vantara_set_block_order(piece, {});
+			return;
+		}
+		std::vector<int> order(static_cast<std::size_t>(n));
+		std::vector<int> key(static_cast<std::size_t>(n));
+		for (int j = 0; j < n; ++j)
+		{
+			order[std::size_t(j)] = j;
+			int best = n;
+			for (int const b : starts) best = std::min(best, (j - b + n) % n);
+			key[std::size_t(j)] = best;
+		}
+		std::stable_sort(order.begin(), order.end()
+			, [&key](int const a, int const b) { return key[std::size_t(a)] < key[std::size_t(b)]; });
+		m_picker->vantara_set_block_order(piece, std::move(order));
+	}
