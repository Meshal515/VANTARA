+	// VANTARA (fresh-queue): before a peer's download rate is measured,
+	// download_queue_time() assumes 50 B/s, so a single outstanding 16 KiB
+	// request reads as a 5-minute queue and request_time_critical_pieces stops
+	// at its "queue longer than 2 s" check. At playback start every peer is in
+	// that state, so the piece the player waits for is not requested until rates
+	// settle seconds later. With VANTARA_LT_FRESH_QUEUE > 0, a peer without a
+	// measured rate counts as full only once it holds that many requests.
+	int vantara_fresh_queue()
+	{
+		static int const value = vantara_env_int("VANTARA_LT_FRESH_QUEUE");
+		return value;
+	}
+	bool vantara_queue_full(peer_connection const* p)
+	{
+		if (p->download_queue_time() <= milliseconds(2000)) return false;
+		int const fresh = vantara_fresh_queue();
+		if (fresh > 0 && p->statistics().download_payload_rate() == 0)
+			return int(p->download_queue().size() + p->request_queue().size()) >= fresh;
+		return true;
+	}
 
